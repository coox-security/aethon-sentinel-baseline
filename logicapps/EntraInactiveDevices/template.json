{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflows_EntraInactiveDevices_name": {
      "type": "String",
      "defaultValue": "EntraInactiveDevices"
    },
    "connections_azureloganalyticsdatacollector_externalid": {
      "type": "String",
      "metadata": {
        "description": "Resource ID of the existing azureloganalyticsdatacollector API connection (Microsoft.Web/connections/...)"
      }
    },
    "tenantId": {
      "type": "String",
      "metadata": { "description": "Entra tenant ID" }
    },
    "clientId": {
      "type": "String",
      "metadata": { "description": "App registration (client) ID" }
    },
    "clientSecret": {
      "type": "SecureString",
      "metadata": { "description": "App registration client secret value (secure)" }
    },
    "deviceInactivityDays": {
      "type": "Int",
      "defaultValue": 30,
      "minValue": 1,
      "metadata": { "description": "Device inactivity threshold in days (approximateLastSignInDateTime <= now - N days)" }
    }
  },
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('workflows_EntraInactiveDevices_name')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "tenantId": { "defaultValue": "", "type": "String" },
            "clientId": { "defaultValue": "", "type": "String" },
            "clientSecret": { "defaultValue": "", "type": "String" },
            "deviceInactivityDays": { "defaultValue": 30, "type": "Int" }
          },
          "triggers": {
            "Recurrence": {
              "recurrence": {
                "frequency": "Day",
                "interval": 1
              },
              "evaluatedRecurrence": {
                "frequency": "Day",
                "interval": 1
              },
              "type": "Recurrence"
            }
          },
          "actions": {
            "Set_variables": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  { "name": "tenantId", "type": "string", "value": "@parameters('tenantId')" },
                  { "name": "clientId", "type": "string", "value": "@parameters('clientId')" },
                  { "name": "clientSecret", "type": "string", "value": "@parameters('clientSecret')" }
                ]
              }
            },
            "Get_Token": {
              "runAfter": { "Set_variables": [ "Succeeded" ] },
              "type": "Http",
              "inputs": {
                "uri": "https://login.microsoftonline.com/@{variables('tenantId')}/oauth2/v2.0/token",
                "method": "POST",
                "headers": { "Content-Type": "application/x-www-form-urlencoded" },
                "body": "grant_type=client_credentials&client_id=@{variables('clientId')}&client_secret=@{variables('clientSecret')}&scope=https://graph.microsoft.com/.default"
              }
            },
            "HTTP_List_Devices": {
              "runAfter": { "Get_Token": [ "Succeeded" ] },
              "type": "Http",
              "inputs": {
                "uri": "https://graph.microsoft.com/v1.0/devices?$select=id,displayName,approximateLastSignInDateTime,accountEnabled,createdDateTime,deletedDateTime,complianceExpirationDateTime,operatingSystem&$top=999",
                "method": "GET",
                "headers": {
                  "Authorization": "Bearer @{body('Get_Token')?['access_token']}",
                  "ConsistencyLevel": "eventual"
                }
              },
              "runtimeConfiguration": {
                "paginationPolicy": { "minimumItemCount": 1000 }
              }
            },
            "Parse_Device_List": {
              "runAfter": { "HTTP_List_Devices": [ "Succeeded" ] },
              "type": "ParseJson",
              "inputs": {
                "content": "@body('HTTP_List_Devices')?['value']",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "displayName": { "type": [ "string", "null" ] },
                      "approximateLastSignInDateTime": { "type": [ "string", "null" ] },
                      "accountEnabled": { "type": [ "boolean", "null" ] },
                      "createdDateTime": { "type": [ "string", "null" ] },
                      "deletedDateTime": { "type": [ "string", "null" ] },
                      "complianceExpirationDateTime": { "type": [ "string", "null" ] },
                      "operatingSystem": { "type": [ "string", "null" ] }
                    },
                    "required": [ "id" ]
                  }
                }
              }
            },
            "Filter_StaleDevices": {
              "runAfter": { "Parse_Device_List": [ "Succeeded" ] },
              "type": "Query",
              "inputs": {
                "from": "@body('Parse_Device_List')",
                "where": "@and(not(empty(item()?['approximateLastSignInDateTime'])), lessOrEquals(ticks(parseDateTime(item()?['approximateLastSignInDateTime'])), ticks(addDays(utcNow(), mul(-1, parameters('deviceInactivityDays'))))))"
              }
            },
            "For_Each_Device": {
              "runAfter": { "Filter_StaleDevices": [ "Succeeded" ] },
              "type": "Foreach",
              "foreach": "@body('Filter_StaleDevices')",
              "actions": {
                "HTTP_Get_Owner": {
                  "type": "Http",
                  "inputs": {
                    "uri": "@{concat('https://graph.microsoft.com/v1.0/devices/', items('For_Each_Device')?['id'], '/registeredOwners?$select=userPrincipalName')}",
                    "method": "GET",
                    "headers": {
                      "Authorization": "Bearer @{body('Get_Token')?['access_token']}",
                      "ConsistencyLevel": "eventual"
                    }
                  }
                },
                "Compose_Device_Info": {
                  "runAfter": { "HTTP_Get_Owner": [ "Succeeded" ] },
                  "type": "Compose",
                  "inputs": {
                    "deviceInfo": {
                      "deviceId": "@items('For_Each_Device')?['id']",
                      "deviceName": "@coalesce(items('For_Each_Device')?['displayName'],'')",
                      "lastSignIn": "@items('For_Each_Device')?['approximateLastSignInDateTime']",
                      "accountEnabled": "@items('For_Each_Device')?['accountEnabled']",
                      "ownerUPN": "@coalesce(first(body('HTTP_Get_Owner')?['value'])?['userPrincipalName'],'')",
                      "createdDateTime": "@items('For_Each_Device')?['createdDateTime']",
                      "deletedDateTime": "@items('For_Each_Device')?['deletedDateTime']",
                      "complianceExpirationDateTime": "@items('For_Each_Device')?['complianceExpirationDateTime']",
                      "operatingSystem": "@items('For_Each_Device')?['operatingSystem']"
                    }
                  }
                },
                "Send_Data": {
                  "runAfter": { "Compose_Device_Info": [ "Succeeded" ] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azureloganalyticsdatacollector']['connectionId']"
                      }
                    },
                    "method": "post",
                    "body": "@outputs('Compose_Device_Info')",
                    "headers": {
                      "Log-Type": "InactiveEntraDevices"
                    },
                    "path": "/api/logs"
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "type": "Object",
            "value": {
              "azureloganalyticsdatacollector": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azureloganalyticsdatacollector')]",
                "connectionId": "[parameters('connections_azureloganalyticsdatacollector_externalid')]",
                "connectionName": "azureloganalyticsdatacollector",
                "connectionProperties": {}
              }
            }
          },
          "tenantId": { "value": "[parameters('tenantId')]" },
          "clientId": { "value": "[parameters('clientId')]" },
          "clientSecret": { "value": "[parameters('clientSecret')]" },
          "deviceInactivityDays": { "value": "[parameters('deviceInactivityDays')]" }
        }
      }
    }
  ]
}
