{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflows_DeviceAccountDisable_name": {
      "type": "String",
      "defaultValue": "DeviceAccountDisable"
    },

    "tenantId": { "type": "String" },
    "clientId": { "type": "String" },
    "clientSecret": { "type": "SecureString" },

    "userInactivityDays": {
      "type": "Int",
      "defaultValue": 30,
      "minValue": 1
    },
    "deviceInactivityDays": {
      "type": "Int",
      "defaultValue": 45,
      "minValue": 1
    },

    "excludedObjectIdsCsv": {
      "type": "String",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated list of Entra object IDs to exclude from disable actions (users/devices). Example: id1,id2,id3"
      }
    },

    "environment": {
      "type": "String",
      "defaultValue": "commercial",
      "allowedValues": [ "commercial", "gcch" ],
      "metadata": {
        "description": "Controls Graph + Login endpoints. commercial=graph.microsoft.com/login.microsoftonline.com, gcch=graph.microsoft.us/login.microsoftonline.us"
      }
    }
  },
  "variables": {
    "graphHost": "[if(equals(parameters('environment'),'gcch'), 'graph.microsoft.us', 'graph.microsoft.com')]",
    "loginHost": "[if(equals(parameters('environment'),'gcch'), 'login.microsoftonline.us', 'login.microsoftonline.com')]",
    "graphScope": "[if(equals(parameters('environment'),'gcch'), 'https://graph.microsoft.us/.default', 'https://graph.microsoft.com/.default')]"
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('workflows_DeviceAccountDisable_name')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "state": "Disabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "tenantId": { "type": "String", "defaultValue": "" },
            "clientId": { "type": "String", "defaultValue": "" },
            "clientSecret": { "type": "SecureString", "defaultValue": "" },

            "userInactivityDays": { "type": "Int", "defaultValue": 30 },
            "deviceInactivityDays": { "type": "Int", "defaultValue": 45 },

            "excludedObjectIdsCsv": { "type": "String", "defaultValue": "" },

            "environment": { "type": "String", "defaultValue": "commercial" }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": { "frequency": "Day", "interval": 1 },
              "evaluatedRecurrence": { "frequency": "Day", "interval": 1 }
            }
          },
          "actions": {
            "Init_Variables": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  { "name": "tenantId", "type": "string", "value": "@parameters('tenantId')" },
                  { "name": "clientId", "type": "string", "value": "@parameters('clientId')" },
                  { "name": "clientSecret", "type": "string", "value": "@parameters('clientSecret')" },

                  { "name": "userInactivityDays", "type": "integer", "value": "@parameters('userInactivityDays')" },
                  { "name": "deviceInactivityDays", "type": "integer", "value": "@parameters('deviceInactivityDays')" },

                  {
                    "name": "excludedObjectIds",
                    "type": "array",
                    "value": "@if(or(equals(trim(parameters('excludedObjectIdsCsv')), ''), empty(trim(parameters('excludedObjectIdsCsv')))), createArray(''), split(replace(replace(trim(parameters('excludedObjectIdsCsv')),' ',''),'\\n',''), ','))"
                  },

                  { "name": "environment", "type": "string", "value": "@parameters('environment')" },
                  {
                    "name": "graphHost",
                    "type": "string",
                    "value": "@if(equals(toLower(parameters('environment')), 'gcch'), 'graph.microsoft.us', 'graph.microsoft.com')"
                  },
                  {
                    "name": "loginHost",
                    "type": "string",
                    "value": "@if(equals(toLower(parameters('environment')), 'gcch'), 'login.microsoftonline.us', 'login.microsoftonline.com')"
                  },
                  {
                    "name": "graphScope",
                    "type": "string",
                    "value": "@if(equals(toLower(parameters('environment')), 'gcch'), 'https://graph.microsoft.us/.default', 'https://graph.microsoft.com/.default')"
                  }
                ]
              }
            },

            "Get_Token": {
              "runAfter": { "Init_Variables": [ "Succeeded" ] },
              "type": "Http",
              "inputs": {
                "uri": "@{concat('https://', variables('loginHost'), '/', variables('tenantId'), '/oauth2/v2.0/token')}",
                "method": "POST",
                "headers": { "Content-Type": "application/x-www-form-urlencoded" },
                "body": "grant_type=client_credentials&client_id=@{variables('clientId')}&client_secret=@{variables('clientSecret')}&scope=@{encodeUriComponent(variables('graphScope'))}"
              }
            },

            "Get_Users": {
              "runAfter": { "Get_Token": [ "Succeeded" ] },
              "type": "Http",
              "inputs": {
                "uri": "@{concat('https://', variables('graphHost'), '/v1.0/users?$select=id,userPrincipalName,accountEnabled,signInActivity&$top=999')}",
                "method": "GET",
                "headers": {
                  "Authorization": "Bearer @{body('Get_Token')?['access_token']}",
                  "ConsistencyLevel": "eventual"
                }
              },
              "runtimeConfiguration": {
                "paginationPolicy": { "minimumItemCount": 1000 }
              }
            },

            "Get_Devices": {
              "runAfter": { "Get_Token": [ "Succeeded" ] },
              "type": "Http",
              "inputs": {
                "uri": "@{concat('https://', variables('graphHost'), '/v1.0/devices?$select=id,accountEnabled,displayName,approximateLastSignInDateTime&$top=999')}",
                "method": "GET",
                "headers": {
                  "Authorization": "Bearer @{body('Get_Token')?['access_token']}",
                  "ConsistencyLevel": "eventual"
                }
              },
              "runtimeConfiguration": {
                "paginationPolicy": { "minimumItemCount": 1000 }
              }
            },

            "Filter_Users": {
              "runAfter": { "Get_Users": [ "Succeeded" ] },
              "type": "Query",
              "inputs": {
                "from": "@coalesce(body('Get_Users')?['value'], createArray())",
                "where": "@and(not(empty(item()?['signInActivity']?['lastSignInDateTime'])), lessOrEquals(ticks(parseDateTime(item()?['signInActivity']?['lastSignInDateTime'])), ticks(addDays(utcNow(), mul(-1, variables('userInactivityDays'))))), not(contains(concat('|', join(variables('excludedObjectIds'),'|'), '|'), concat('|', item()?['id'], '|'))))"
              }
            },

            "Filter_Devices": {
              "runAfter": { "Get_Devices": [ "Succeeded" ] },
              "type": "Query",
              "inputs": {
                "from": "@coalesce(body('Get_Devices')?['value'], createArray())",
                "where": "@and(not(empty(item()?['approximateLastSignInDateTime'])), lessOrEquals(ticks(parseDateTime(item()?['approximateLastSignInDateTime'])), ticks(addDays(utcNow(), mul(-1, variables('deviceInactivityDays'))))), not(contains(concat('|', join(variables('excludedObjectIds'),'|'), '|'), concat('|', item()?['id'], '|'))))"
              }
            },

            "Compose_DisabledUsersPreview": {
              "runAfter": { "Filter_Users": [ "Succeeded" ] },
              "type": "Compose",
              "inputs": "@body('Filter_Users')"
            },

            "Compose_DisabledDevicesPreview": {
              "runAfter": { "Filter_Devices": [ "Succeeded" ] },
              "type": "Compose",
              "inputs": "@body('Filter_Devices')"
            },

            "Disable_Users": {
              "runAfter": { "Compose_DisabledUsersPreview": [ "Succeeded" ] },
              "type": "Foreach",
              "foreach": "@coalesce(outputs('Compose_DisabledUsersPreview'), createArray())",
              "actions": {
                "PATCH_User_Disable": {
                  "type": "Http",
                  "inputs": {
                    "uri": "@{concat('https://', variables('graphHost'), '/v1.0/users/', items('Disable_Users')?['id'])}",
                    "method": "PATCH",
                    "headers": {
                      "Authorization": "Bearer @{body('Get_Token')?['access_token']}",
                      "Content-Type": "application/json"
                    },
                    "body": { "accountEnabled": false }
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": { "transferMode": "Chunked" }
                  }
                }
              }
            },

            "Disable_Devices": {
              "runAfter": { "Compose_DisabledDevicesPreview": [ "Succeeded" ] },
              "type": "Foreach",
              "foreach": "@coalesce(outputs('Compose_DisabledDevicesPreview'), createArray())",
              "actions": {
                "PATCH_Device_Disable": {
                  "type": "Http",
                  "inputs": {
                    "uri": "@{concat('https://', variables('graphHost'), '/v1.0/devices/', items('Disable_Devices')?['id'])}",
                    "method": "PATCH",
                    "headers": {
                      "Authorization": "Bearer @{body('Get_Token')?['access_token']}",
                      "Content-Type": "application/json"
                    },
                    "body": { "accountEnabled": false }
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": { "transferMode": "Chunked" }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "tenantId": { "value": "[parameters('tenantId')]" },
          "clientId": { "value": "[parameters('clientId')]" },
          "clientSecret": { "value": "[parameters('clientSecret')]" },

          "userInactivityDays": { "value": "[parameters('userInactivityDays')]" },
          "deviceInactivityDays": { "value": "[parameters('deviceInactivityDays')]" },

          "excludedObjectIdsCsv": { "value": "[parameters('excludedObjectIdsCsv')]" },

          "environment": { "value": "[parameters('environment')]" }
        }
      }
    }
  ]
}
