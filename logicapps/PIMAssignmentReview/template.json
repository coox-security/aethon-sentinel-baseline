{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflows_PIMAssignmentReview_name": {
      "type": "String",
      "defaultValue": "PIMAssignmentReview"
    },
    "connections_azureloganalyticsdatacollector_externalid": {
      "type": "String",
      "metadata": {
        "description": "Resource ID of the existing azureloganalyticsdatacollector API connection (Microsoft.Web/connections/...)"
      }
    },
    "tenantId": {
      "type": "String",
      "metadata": { "description": "Entra tenant ID" }
    },
    "clientId": {
      "type": "String",
      "metadata": { "description": "App registration (client) ID" }
    },
    "clientSecret": {
      "type": "SecureString",
      "metadata": { "description": "App registration client secret value (secure)" }
    }
  },
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('workflows_PIMAssignmentReview_name')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "defaultValue": {}, "type": "Object" },
            "tenantId": { "defaultValue": "", "type": "String" },
            "clientId": { "defaultValue": "", "type": "String" },
            "clientSecret": { "defaultValue": "", "type": "String" }
          },
          "triggers": {
            "Recurrence": {
              "recurrence": { "interval": 1, "frequency": "Day" },
              "evaluatedRecurrence": { "interval": 1, "frequency": "Day" },
              "type": "Recurrence"
            }
          },
          "actions": {
            "Set_variables": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  { "name": "tenantId", "type": "string", "value": "@parameters('tenantId')" },
                  { "name": "clientId", "type": "string", "value": "@parameters('clientId')" },
                  { "name": "clientSecret", "type": "string", "value": "@parameters('clientSecret')" }
                ]
              }
            },
            "Get_Graph_Token": {
              "runAfter": { "Set_variables": [ "Succeeded" ] },
              "type": "Http",
              "inputs": {
                "uri": "https://login.microsoftonline.com/@{variables('tenantId')}/oauth2/v2.0/token",
                "method": "POST",
                "headers": { "Content-Type": "application/x-www-form-urlencoded" },
                "body": "grant_type=client_credentials&client_id=@{variables('clientId')}&client_secret=@{variables('clientSecret')}&scope=https://graph.microsoft.com/.default"
              },
              "runtimeConfiguration": {
                "contentTransfer": { "transferMode": "Chunked" }
              }
            },
            "Get_PIM_Assignments": {
              "runAfter": { "Get_Graph_Token": [ "Succeeded" ] },
              "type": "Http",
              "inputs": {
                "uri": "https://graph.microsoft.com/beta/roleManagement/directory/roleAssignmentScheduleInstances?$top=999",
                "method": "GET",
                "headers": {
                  "Authorization": "Bearer @{body('Get_Graph_Token')?['access_token']}"
                }
              },
              "runtimeConfiguration": {
                "contentTransfer": { "transferMode": "Chunked" }
              }
            },
            "Parse_Assignments": {
              "runAfter": { "Get_PIM_Assignments": [ "Succeeded" ] },
              "type": "ParseJson",
              "inputs": {
                "content": "@body('Get_PIM_Assignments')?['value']",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "assignmentType": { "type": "string" },
                      "memberType": { "type": "string" },
                      "directoryScopeId": { "type": [ "string", "null" ] },
                      "principalId": { "type": "string" },
                      "roleDefinitionId": { "type": "string" },
                      "startDateTime": { "type": [ "string", "null" ] },
                      "endDateTime": { "type": [ "string", "null" ] },
                      "status": { "type": "string" }
                    }
                  }
                }
              }
            },
            "Compose_Enriched_Record": {
              "runAfter": { "Parse_Assignments": [ "Succeeded" ] },
              "type": "Foreach",
              "foreach": "@body('Parse_Assignments')",
              "actions": {
                "Get_User": {
                  "type": "Http",
                  "inputs": {
                    "uri": "https://graph.microsoft.com/v1.0/users/@{items('Compose_Enriched_Record')?['principalId']}",
                    "method": "GET",
                    "headers": {
                      "Authorization": "Bearer @{body('Get_Graph_Token')?['access_token']}"
                    }
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": { "transferMode": "Chunked" }
                  }
                },
                "Get_Service_Principal": {
                  "runAfter": { "Get_User": [ "Succeeded", "Failed", "Skipped" ] },
                  "type": "Http",
                  "inputs": {
                    "uri": "https://graph.microsoft.com/v1.0/servicePrincipals/@{items('Compose_Enriched_Record')?['principalId']}",
                    "method": "GET",
                    "headers": {
                      "Authorization": "Bearer @{body('Get_Graph_Token')?['access_token']}"
                    }
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": { "transferMode": "Chunked" }
                  }
                },
                "Get_Group": {
                  "runAfter": { "Get_Service_Principal": [ "Succeeded", "Skipped", "Failed" ] },
                  "type": "Http",
                  "inputs": {
                    "uri": "https://graph.microsoft.com/v1.0/groups/@{items('Compose_Enriched_Record')?['principalId']}",
                    "method": "GET",
                    "headers": {
                      "Authorization": "Bearer @{body('Get_Graph_Token')?['access_token']}"
                    }
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": { "transferMode": "Chunked" }
                  }
                },
                "Get_Role_Definition": {
                  "runAfter": { "Get_Group": [ "Succeeded", "Skipped", "Failed" ] },
                  "type": "Http",
                  "inputs": {
                    "uri": "https://graph.microsoft.com/beta/roleManagement/directory/roleDefinitions/@{items('Compose_Enriched_Record')?['roleDefinitionId']}",
                    "method": "GET",
                    "headers": {
                      "Authorization": "Bearer @{body('Get_Graph_Token')?['access_token']}"
                    }
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": { "transferMode": "Chunked" }
                  }
                },
                "Compose_1": {
                  "runAfter": { "Get_Role_Definition": [ "Succeeded", "Skipped", "Failed" ] },
                  "type": "Compose",
                  "inputs": {
                    "principalId": "@{items('Compose_Enriched_Record')?['principalId']}",
                    "name": "@{if(equals(outputs('Get_User')?['statusCode'], 200), body('Get_User')?['userPrincipalName'], if(equals(outputs('Get_Group')?['statusCode'], 200), body('Get_Group')?['displayName'], if(equals(outputs('Get_Service_Principal')?['statusCode'], 200), body('Get_Service_Principal')?['displayName'], 'unknown')))}",
                    "type": "@{if(equals(outputs('Get_User')?['statusCode'], 200), 'user', if(equals(outputs('Get_Group')?['statusCode'], 200), 'group', if(equals(outputs('Get_Service_Principal')?['statusCode'], 200), 'servicePrincipal', 'unknown')))}",
                    "roleId": "@{items('Compose_Enriched_Record')?['roleDefinitionId']}",
                    "roleName": "@{if(equals(outputs('Get_Role_Definition')?['statusCode'], 200), body('Get_Role_Definition')?['displayName'], 'unknown')}",
                    "assignmentType": "@{items('Compose_Enriched_Record')?['assignmentType']}",
                    "memberType": "@{items('Compose_Enriched_Record')?['memberType']}",
                    "directoryScopeId": "@{items('Compose_Enriched_Record')?['directoryScopeId']}",
                    "startDateTime": "@{items('Compose_Enriched_Record')?['startDateTime']}",
                    "endDateTime": "@{items('Compose_Enriched_Record')?['endDateTime']}",
                    "status": "@{items('Compose_Enriched_Record')?['status']}",
                    "TimeGenerated": "@{utcNow()}"
                  }
                },
                "Send_Data": {
                  "runAfter": { "Compose_1": [ "Succeeded", "Skipped", "Failed" ] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azureloganalyticsdatacollector']['connectionId']"
                      }
                    },
                    "method": "post",
                    "body": "@outputs('Compose_1')",
                    "headers": {
                      "Log-Type": "PIMAssignments"
                    },
                    "path": "/api/logs"
                  }
                }
              }
            }
          }
        },
        "parameters": {
          "$connections": {
            "type": "Object",
            "value": {
              "azureloganalyticsdatacollector": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azureloganalyticsdatacollector')]",
                "connectionId": "[parameters('connections_azureloganalyticsdatacollector_externalid')]",
                "connectionName": "azureloganalyticsdatacollector"
              }
            }
          },
          "tenantId": { "value": "[parameters('tenantId')]" },
          "clientId": { "value": "[parameters('clientId')]" },
          "clientSecret": { "value": "[parameters('clientSecret')]" }
        }
      }
    }
  ]
}
